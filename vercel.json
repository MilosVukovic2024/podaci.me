{
  "trailingSlash": true,
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/analize/skupstina-2023-2026/:path*/",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/analize/skupstina-2023-2026/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/analize/monstat-u-brojkama/",
      "destination": "/analize/crna-gora-u-brojkama-monstata/",
      "permanent": true
    },
    {
      "source": "/analize/monstat-u-brojkama/:path*/",
      "destination": "/analize/crna-gora-u-brojkama-monstata/",
      "permanent": true
    },
    {
      "source": "/analize/monstat-u-brojkama/:path*",
      "destination": "/analize/crna-gora-u-brojkama-monstata/",
      "permanent": true
    },
    {
      "source": "/analize/monstat-u-brojkama",
      "destination": "/analize/crna-gora-u-brojkama-monstata/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/arhiva/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
